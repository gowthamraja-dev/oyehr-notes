// Lead generation (public pricing-page enquiries) — schema
// STATUS: approved         (draft → approved → superseded)
// CLONE: workspace-1/hrms
// APPROVED_ON: 2026-11-06 (FINAL: the lead_masters block was supplied by the user and replaces rev 1-3)
// Scope: table + Alembic migration only. Model: app/models/lead_master.py. Migration: alembic/versions/e6b2d8f4a173_lead_masters.py (APPLIED by hand to the shared hrms-dev DB on 2026-11-06; Alembic stamp left at 8012104013b3).
// Paste into https://dbdiagram.io (DBML). Plan: .plans/lead-generation-plan.md (behaviour lives there, not here)
//
// Header colours:
//   green  #2E7D32  NEW table
//   grey   #616161  existing, read only / referenced (columns trimmed)

Project lead_generation {
  database_type: 'PostgreSQL'
  Note: '''
  ## Why
  A prospect who enquires about a plan on the public Subscriptions page is stored as a lead (company name, email, mobile, plan, stage).
  ## Feasibility
  - Tenant scoping: NOT tenant-scoped on purpose (a prospect has no CDP). Platform-level, Super Admin only; no tenant query may read it.
  - Column names copy users / care_delivery_program_masters (name, email, mobile) so pre-populating Add Organization is a straight copy.
  - Stage: status_master_id -> status_masters (source_activity LEAD), seeded by the migration, looked up by code. No DB default (ids differ per DB).
  - No CHECK constraints: validation lives in the application.
  - Soft delete: is_active / archive / archived_by_id / archived_at. List, dedupe and resume queries must filter archive = false.
  - Existing data: no existing table is altered. The migration only creates lead_masters and inserts the LEAD status rows.
  ## Decided
  Final column set supplied by the user on 2026-11-06; applied to hrms-dev the same day (table, 4 indexes, 8 LEAD status rows, backup_user SELECT). Billing address, OTP/resume, conversion and CDP onboarding columns are out of this schema.
  '''
}

Enum lead_status {
  NEW
  CONTACTED
  QUALIFIED
  ADDRESS_ADDED
  SUBSCRIBED
  CONVERTED
  COMPLETED
  LOST
}

Table lead_masters [headercolor: #2E7D32] {
  id bigint [pk]

  // who
  name varchar(255) [not null, note: 'company name; same name / length as care_delivery_program_masters.name and corp_masters.name']
  email varchar(255) [not null, note: 'same as users.email. Plain ASCII. Compared case-insensitively']
  mobile varchar(25) [not null, note: 'same name as users.mobile (varchar(20): trim punctuation on conversion). As typed, 7-15 digits']

  // plan and subscription (before an organisation exists)
  subscription_plan_master_id bigint [ref: > subscription_plan_masters.id, note: 'plan chosen, resolved by plan_code. NULL if the page plan has no catalogue row']
  subscription_price_master_id bigint [ref: > subscription_price_masters.id, note: 'the catalogue price agreed at subscribe time']
  subscribed_at timestamptz [note: 'subscription confirmed']

  // pipeline
  status_master_id bigint [not null, ref: > status_masters.id, note: 'stage = status_masters row, source_activity LEAD (see lead_status). NO DB default: the insert supplies the id of NEW, resolved by status_code']

  is_active boolean [not null, default: true]
  archive boolean [not null, default: false]
  archived_by_id bigint [ref: > users.id]
  archived_at timestamptz
  created_by_id bigint [ref: > users.id, note: 'NULL for a public submission']
  updated_by_id bigint [ref: > users.id, note: 'NULL for a public step; the Super Admin when confirmed by hand']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'onupdate now()']

  Indexes {
    (status_master_id, created_at) [name: 'ix_lead_masters_status_created', note: 'list by status, newest first. Queries also filter archive = false']
    subscription_plan_master_id [name: 'ix_lead_masters_subscription_plan_master_id']
    mobile [name: 'ix_lead_masters_mobile', note: 'resume lookup by mobile']
    (email) [name: 'ix_lead_masters_email_lower', note: 'functional: lower(email) WHERE archive = false. Dedupe + resume lookup. DBML cannot express the function/WHERE']
  }

  Note: '[NEW] app/models/lead_master.py → LeadMaster. NOT tenant-scoped: platform-level, Super Admin only. No CHECK constraints: the FK to status_masters is the only stage constraint.'
}

Table status_masters [headercolor: #616161] {
  id bigint [pk]
  status_code varchar(100) [note: 'see enum lead_status, for source_activity = LEAD']
  status_name varchar(255)
  source_activity varchar(255) [note: 'LEAD for this feature (new value)']
  next_step varchar(255)
  can_change boolean
  is_active boolean

  Note: 'Existing: app/models/status_master.py. Gains EIGHT seeded ROWS for source_activity LEAD (data, no schema change).'
}

Table subscription_plan_masters [headercolor: #616161] {
  id bigint [pk]
  plan_code varchar(50) [unique]
  plan_name varchar(100)

  Note: 'Existing. Read only.'
}

Table subscription_price_masters [headercolor: #616161] {
  id bigint [pk]
  subscription_plan_master_id bigint
  billing_interval varchar(20) [note: 'MONTHLY | YEARLY']
  base_price numeric
  currency_code varchar(3)

  Note: 'Existing. Read only.'
}

Table users [headercolor: #616161] {
  id bigint [pk]
  email varchar(255)

  Note: 'Existing. Referenced for audit columns.'
}

TableGroup lead_generation {
  lead_masters
  status_masters
  subscription_plan_masters
  subscription_price_masters
  users
}
