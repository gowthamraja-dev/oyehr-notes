+def list_my_optional_holidays(db: Session, principal: AuthPrincipal, year: int | None) -> MyOptionalHolidaysOut:
+    """Task 186: the caller's own Optional/Restricted holidays for `year`, each with whether
+    they have taken/requested it, plus the quota of the tenant's OptionalHoliday leave type.
+    A picker for the apply form — `validate_optional_holiday_dates` stays the authority.
+
+    Candidates are every Optional/Restricted holiday in this tenant's calendars for the year;
+    a date is kept only when the employee's *own* resolved calendar on that date carries it
+    (`resolve_optional_holiday`), so a mid-year location move is honoured per date.
+    """
+    employee = _require_self_employee(db, principal)
+    tenant_id = principal.tenant_id
+    today = date.today()
+    target_year = year or today.year
+
+    candidate_dates = db.scalars(
+        select(HolidayDetail.holiday_date)
+        .join(HolidayCalendarMaster, HolidayCalendarMaster.id == HolidayDetail.holiday_calendar_master_id)
+        .where(
+            HolidayCalendarMaster.care_delivery_program_master_id == tenant_id,
+            HolidayCalendarMaster.year == target_year,
+            HolidayDetail.care_delivery_program_master_id == tenant_id,
+            HolidayDetail.holiday_type.in_(OPTIONAL_HOLIDAY_TYPES),
+            HolidayDetail.is_active.is_(True),
+            HolidayDetail.archive.is_(False),
+        )
+        .distinct()
+    ).all()
+    holidays: list[HolidayDetail] = []
+    for holiday_date in sorted(candidate_dates):
+        resolved_shift = resolve_effective_shift(db, tenant_id, employee.id, holiday_date)
+        holiday = resolve_optional_holiday(db, tenant_id, holiday_date, resolved_shift)
+        if holiday is not None:
+            holidays.append(holiday)
+
+    leave_type = db.scalar(
+        select(LeaveTypeMaster)
+        .where(
+            LeaveTypeMaster.care_delivery_program_master_id == tenant_id,
+            LeaveTypeMaster.date_rule == DATE_RULE_OPTIONAL_HOLIDAY,
+            LeaveTypeMaster.is_active.is_(True),
+            LeaveTypeMaster.archive.is_(False),
+        )
+        .order_by(LeaveTypeMaster.display_order, LeaveTypeMaster.id)
+    )
+
+    status_by_date: dict[date, str] = {}
+    quota: Decimal | None = None
+    used = pending = available = Decimal("0")
+    if leave_type is not None:
+        if holidays:
+            for leave_date, status in db.execute(
+                select(LeaveRequestDayDetail.leave_date, LeaveRequestDetail.status)
+                .join(LeaveRequestDetail, LeaveRequestDetail.id == LeaveRequestDayDetail.leave_request_detail_id)
+                .where(
+                    LeaveRequestDetail.care_delivery_program_master_id == tenant_id,
+                    LeaveRequestDetail.employee_master_id == employee.id,
+                    LeaveRequestDetail.leave_type_master_id == leave_type.id,
+                    LeaveRequestDetail.status.in_(("Pending", "Approved")),
+                    LeaveRequestDetail.archive.is_(False),
+                    LeaveRequestDayDetail.day_fraction > 0,
+                    LeaveRequestDayDetail.leave_date.in_([h.holiday_date for h in holidays]),
+                )
+            ).all():
+                if status == "Approved" or leave_date not in status_by_date:
+                    status_by_date[leave_date] = "Taken" if status == "Approved" else "Pending"
+
+        as_of = min(max(today, date(target_year, 1, 1)), date(target_year, 12, 31))
+        policy = resolution.resolve_policy_detail(db, tenant_id, employee, leave_type.id, as_of)
+        if policy is not None:
+            quota = policy.accrual_quantity
+            leave_year = resolve_leave_year(policy, as_of)
+            _, pending, available = ledger_service.get_available_balance(
+                db, tenant_id, employee.id, leave_type.id, leave_year,
+            )
+            used = _used_ytd(db, tenant_id, employee.id, leave_type.id, leave_year)
+
+    return MyOptionalHolidaysOut(
+        year=target_year,
+        leave_type_master_id=leave_type.id if leave_type is not None else None,
+        quota=quota, used=used, pending=pending, available_balance=available,
+        holidays=[
+            MyOptionalHolidayOut(
+                holiday_detail_id=h.id, holiday_date=h.holiday_date, name=h.name, holiday_type=h.holiday_type,
+                status=status_by_date.get(h.holiday_date) or ("Past" if h.holiday_date < today else "Available"),
+            )
+            for h in holidays
+        ],
+    )
+
