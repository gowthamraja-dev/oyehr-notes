+@pytest.fixture()
+def setup(client, db_session, tenant):
+    """Employee (tenant.user) + manager, an all-locations calendar with Optional holidays on
+    Mon/Tue/Wed, a Public holiday on Thu and an Optional one on Sat, and an OH type with quota 2."""
+    week = _week()
+    emp, manager = _self_employee_with_manager(db_session, tenant)
+    cal = _calendar(db_session, tenant.org.id, week[0].year)
+    optional = [_holiday(db_session, cal, d) for d in week[0:3]]
+    public = _holiday(db_session, cal, week[3], "Public")
+    saturday = _holiday(db_session, cal, week[5], "Restricted")
+    lt = _oh_type(db_session, tenant.org.id, year=week[0].year, employee=emp)
+    return dict(week=week, emp=emp, manager=manager, cal=cal, optional=optional, public=public,
+                saturday=saturday, lt=lt, token=_login(client))
