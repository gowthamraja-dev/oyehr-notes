+"""Task 186: optional holidays as a quota'd leave type.
+
+The N holidays are `holiday_details` rows of type Optional/Restricted; a leave type with
+`date_rule='OptionalHoliday'` may only be applied on those dates in the employee's own resolved
+calendar, and its policy's Yearly quota (on a January leave year) caps how many are taken.
+
+No shift is assigned in these tests, so the calendar resolver falls back to the all-locations
+calendar and the Sat/Sun default week-off.
+"""
+
+from datetime import date, timedelta
+from decimal import Decimal
+
+import pytest
+
+from app.models import (
+    CareDeliveryProgramMaster,
+    CorpMaster,
+    EmployeeMaster,
+    HolidayCalendarMaster,
+    HolidayDetail,
+    LeavePolicyDetail,
+    LeaveTypeMaster,
+    StatusMaster,
+    WorkLocationMaster,
+)
+from app.modules.leave import service as leave_service
+from app.services import ledger_service
+from app.tests.modules.test_leave import (
+    LEAVE_PREVIEW,
+    LEAVE_REQUESTS,
+    LEAVE_TYPES,
+    _apply_payload,
+    _auth,
+    _create_type,
+    _decrypt,
+    _encrypt,
+    _login,
+    _master,
+    _policy_payload,
+    _public_key,
+    _self_employee_with_manager,
+    admin_token,  # noqa: F401 — fixture
+)
+
+MY_OPTIONAL = "/api/v1/leave/me/optional-holidays"
+
+
+@pytest.fixture(autouse=True)
+def _leave_statuses(db_session, tenant):
+    """The apply flow dual-writes `status_master_id`; seed the four LEAVE_REQUEST rows inside the
+    test transaction when the database has none, and drop the id cache either side so an id from
+    a rolled-back row never leaks into the next test."""
+    leave_service._LEAVE_STATUS_ID_CACHE.clear()
+    for code in ("Pending", "Approved", "Rejected", "Cancelled"):
+        exists = db_session.query(StatusMaster).filter_by(source_activity="LEAVE_REQUEST", status_code=code).first()
+        if exists is None:
+            db_session.add(StatusMaster(
+                status_code=code, status_name=code, source_activity="LEAVE_REQUEST",
+                created_by_id=tenant.user.id, updated_by_id=tenant.user.id,
+            ))
+    db_session.flush()
+    yield
+    leave_service._LEAVE_STATUS_ID_CACHE.clear()
+
+
+def _week() -> list[date]:
+    """Mon..Sun of the first full week at least two weeks ahead that sits inside one calendar year
+    (the quota is per calendar year, so a week straddling 31-Dec would split it)."""
+    start = date.today() + timedelta(days=14)
+    monday = start + timedelta(days=(-start.weekday()) % 7)
+    if (monday + timedelta(days=6)).year != monday.year:
+        monday += timedelta(days=7)
+    return [monday + timedelta(days=i) for i in range(7)]
+
+
+def _calendar(db, cdp_id: int, year: int, *, location_id: int | None = None) -> HolidayCalendarMaster:
+    cal = HolidayCalendarMaster(
+        care_delivery_program_master_id=cdp_id, name=f"Cal {year} {location_id}", year=year,
+        work_location_master_id=location_id,
+    )
+    db.add(cal)
+    db.flush()
+    return cal
+
+
+def _holiday(db, cal: HolidayCalendarMaster, day: date, holiday_type: str = "Optional", name: str = "") -> HolidayDetail:
+    h = HolidayDetail(
+        care_delivery_program_master_id=cal.care_delivery_program_master_id,
+        holiday_calendar_master_id=cal.id, holiday_date=day, name=name or f"Holiday {day}",
+        holiday_type=holiday_type,
+    )
+    db.add(h)
+    db.flush()
+    return h
+
+
+def _oh_type(db, cdp_id: int, *, quota: int = 2, year: int, employee: EmployeeMaster | None = None, **overrides):
+    """An OptionalHoliday leave type with a Yearly/January rule in the DEFAULT policy, and (when
+    `employee` is given) that year's accrual already credited."""
+    defaults = dict(
+        care_delivery_program_master_id=cdp_id, name="Optional Holiday", code="OH",
+        effctv_dt=date(2020, 1, 1), date_rule="OptionalHoliday", allow_half_day=True,
+        min_notice_days=0, requires_approval=False,
+    )
+    defaults.update(overrides)
+    lt = LeaveTypeMaster(**defaults)
+    db.add(lt)
+    db.flush()
+    db.add(LeavePolicyDetail(
+        care_delivery_program_master_id=cdp_id, leave_type_master_id=lt.id,
+        leave_policy_master_id=_master(db, cdp_id).id, accrual_frequency="Yearly",
+        accrual_quantity=quota, accrual_timing="Pre", reset_month=1, prorate_on_joining=False,
+    ))
+    db.flush()
+    if employee is not None:
+        ledger_service.write_ledger_entry(db, cdp_id, employee.id, lt.id, year, "Accrual", Decimal(quota), date(year, 1, 1))
+        db.flush()
+    return lt
+
